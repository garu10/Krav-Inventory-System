# Server Configuration
PORT=5001
NODE_ENV=development

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# Local PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_postgres_password
DB_NAME=krav_inventory
DATABASE_URL=postgresql://postgres:your_postgres_password@localhost:5432/krav_inventory
